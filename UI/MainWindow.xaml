<Window x:Class="RFAQuickPreview.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RFAQuickPreview"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#FFFFFF" BorderBrush="#D6DAE0" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,10">
                <TextBlock DockPanel.Dock="Left"
                           Text="RFAQuickPreview"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0" />
                <TextBox x:Name="SearchTextBox"
                         Width="420"
                         TextChanged="SearchTextBox_TextChanged"
                         ToolTip="Search by file name, family name or category" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="#FFFFFF" BorderBrush="#D6DAE0" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <TextBlock Text="Folder" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox x:Name="FolderTextBox" IsReadOnly="True" />
                <Button x:Name="SelectFolderButton" Content="Select Folder" Click="SelectFolderButton_Click" />
                <Button x:Name="ScanButton" Content="Scan" Click="ScanButton_Click" />
                <TextBlock Text="Cache"
                           FontWeight="SemiBold"
                           Margin="0,24,0,8" />
                <TextBlock Text="%LocalAppData%\RFAQuickPreview\Cache"
                           TextWrapping="Wrap"
                           Foreground="#5E6878" />
            </StackPanel>
        </Border>

        <ListBox x:Name="FamilyListBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="12"
                 BorderThickness="0"
                 Background="Transparent"
                 MouseDoubleClick="FamilyListBox_MouseDoubleClick"
                 SelectionChanged="FamilyListBox_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="190"
                            Height="230"
                            Background="#FFFFFF"
                            BorderBrush="#D6DAE0"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="140" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="#ECEFF3" CornerRadius="6,6,0,0">
                                <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" Margin="8" />
                            </Border>
                            <StackPanel Grid.Row="1" Margin="10">
                                <TextBlock Text="{Binding FileName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding FamilyCategory}"
                                           Foreground="#5E6878"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="#5E6878" Margin="0,6,0,0">
                                    <Run Text="{Binding TypeCount}" />
                                    <Run Text=" types" />
                                </TextBlock>
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="#B42318"
                                           Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1" Grid.Column="2" Background="#FFFFFF" BorderBrush="#D6DAE0" BorderThickness="1,0,0,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="DetailTitleTextBlock"
                           Text="No family selected"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Row="1" Margin="0,12,0,16">
                    <TextBlock x:Name="DetailPathTextBlock" Foreground="#5E6878" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailCategoryTextBlock" Foreground="#5E6878" Margin="0,6,0,0" />
                    <TextBlock x:Name="DetailSizeTextBlock" Foreground="#5E6878" Margin="0,6,0,0" />
                    <TextBlock x:Name="DetailModifiedTextBlock" Foreground="#5E6878" Margin="0,6,0,0" />
                </StackPanel>
                <TabControl Grid.Row="2">
                    <TabItem Header="Parameters">
                        <DataGrid x:Name="ParameterGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding StorageType}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Types">
                        <ListBox x:Name="TypeListBox" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#FFFFFF" BorderBrush="#D6DAE0" BorderThickness="0,1,0,0">
            <Grid Margin="16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock x:Name="ProgressTextBlock" DockPanel.Dock="Left" VerticalAlignment="Center" />
                    <ProgressBar x:Name="ScanProgressBar"
                                 Height="12"
                                 Margin="16,0,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 VerticalAlignment="Center" />
                </DockPanel>
                <TextBox x:Name="LogTextBox"
                         Grid.Row="1"
                         Margin="0,8,0,0"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>

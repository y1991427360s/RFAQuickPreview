<Window x:Class="RFAQuickPreview.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RFAQuickPreview"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Background="#F4F5F7"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="White" BorderBrush="#D6DAE0" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,10">
                <TextBlock Text="RFAQuickPreview" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                <TextBox x:Name="SearchTextBox" Width="420" Height="32" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#D6DAE0" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <TextBlock Text="Folder" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox x:Name="FolderTextBox" IsReadOnly="True" Height="32" VerticalContentAlignment="Center" />
                <Button Content="Select Folder" Height="34" Margin="0,8,0,0" Click="SelectFolderButton_Click" />
                <Button x:Name="ScanButton" Content="Scan" Height="34" Margin="0,8,0,0" Click="ScanButton_Click" />
                <Button Content="Open Folder" Height="34" Margin="0,8,0,0" Click="OpenFolderButton_Click" />
                <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,24,0,8" />
                <TextBlock Text="Drag a preview card into Revit to load the family into the active model." TextWrapping="Wrap" Foreground="#5E6878" />
            </StackPanel>
        </Border>

        <ListBox x:Name="FileListBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="12"
                 BorderThickness="0"
                 Background="Transparent"
                 MouseDoubleClick="FileListBox_MouseDoubleClick"
                 PreviewMouseLeftButtonDown="FileListBox_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="FileListBox_PreviewMouseMove"
                 SelectionChanged="FileListBox_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="6" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="190" Height="230" Background="White" BorderBrush="#D6DAE0" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="146" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="#ECEFF3" CornerRadius="6,6,0,0">
                                <Image Source="{Binding ThumbnailPath}" Stretch="Uniform" Margin="8" />
                            </Border>
                            <StackPanel Grid.Row="1" Margin="10">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding FileSizeText}" Foreground="#5E6878" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Status}" Foreground="#5E6878" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="#D6DAE0" BorderThickness="1,0,0,0">
            <StackPanel Margin="16">
                <TextBlock x:Name="DetailTitleTextBlock" Text="No file selected" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Image x:Name="DetailImage" Height="220" Stretch="Uniform" Margin="0,16,0,16" />
                <TextBlock x:Name="DetailPathTextBlock" TextWrapping="Wrap" Foreground="#5E6878" />
                <TextBlock x:Name="DetailSizeTextBlock" Margin="0,8,0,0" Foreground="#5E6878" />
                <TextBlock x:Name="DetailModifiedTextBlock" Margin="0,8,0,0" Foreground="#5E6878" />
                <TextBlock x:Name="DetailFrontWidthTextBlock" Margin="0,8,0,0" Foreground="#5E6878" />
                <TextBlock x:Name="DetailFrontHeightTextBlock" Margin="0,8,0,0" Foreground="#5E6878" />
                <TextBlock x:Name="DetailLeftWidthTextBlock" Margin="0,8,0,0" Foreground="#5E6878" />
                <Button x:Name="PlaceInRevitButton"
                        Content="Place in Revit"
                        Height="34"
                        Margin="0,16,0,0"
                        IsEnabled="False"
                        Click="PlaceInRevitButton_Click" />
                <Button x:Name="RefreshPreviewButton"
                        Content="Refresh Preview"
                        Height="34"
                        Margin="0,8,0,0"
                        IsEnabled="False"
                        Click="RefreshPreviewButton_Click" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="White" BorderBrush="#D6DAE0" BorderThickness="0,1,0,0">
            <Grid Margin="16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock x:Name="ProgressTextBlock" VerticalAlignment="Center" />
                    <ProgressBar x:Name="ProgressBar" Height="12" Margin="16,0,0,0" Minimum="0" Maximum="100" />
                </DockPanel>
                <TextBox x:Name="LogTextBox" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
    </Grid>
</Window>
